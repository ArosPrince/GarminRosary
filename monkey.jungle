project.manifest = manifest.xml

# FORK: Czech texts regardless of the watch language. Later paths override earlier
# ones, so the Czech translation replaces the English defaults, and the fork's own
# strings (full prayer texts) come last. The manifest lists Czech only, so the other
# upstream translations are not built (the compiler warns that they are ignored).
base.resourcePath = $(base.resourcePath);resources-ces;resources-fork
base.lang.ces = $(base.lang.ces);resources-fork
